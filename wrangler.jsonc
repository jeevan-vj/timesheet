{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cleantrack-timesheet",
  "main": "vinext/server/app-router-entry",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "not_found_handling": "none" },
  "secrets": { "required": ["BETTER_AUTH_SECRET"] },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "vars": {
    "BETTER_AUTH_URL": "https://cleantrack-timesheet.jeevan90wijerathna.workers.dev",
    "AUTH_TRUSTED_ORIGINS": "",
    "RELEASE_SHA": "local"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cleantrack-timesheet",
      "database_id": "6870501c-7259-4be2-9dbb-1650112fe9d2",
      "migrations_dir": "drizzle"
    }
  ]
}
