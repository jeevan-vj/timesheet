{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "APP_VARIANT=development expo start --dev-client",
    "android": "APP_VARIANT=development expo start --dev-client --android",
    "ios": "APP_VARIANT=development expo start --dev-client --ios",
    "web": "APP_VARIANT=development expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "node ../../scripts/lint-paved-path.mjs apps/mobile",
    "test": "pnpm --dir ../.. exec vitest run tests/mobile-release-guard.test.mjs tests/mobile-release-plan.test.mjs tests/mobile-fingerprint.test.mjs",
    "update:preview": "APP_VARIANT=preview eas update --channel preview --environment preview",
    "update:production": "APP_VARIANT=production eas update --channel production --environment production",
    "build:production": "node scripts/build-production.mjs",
    "eas-build-pre-install": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.13",
    "@cleantrack/core": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/query-async-storage-persister": "5.105.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-query-persist-client": "5.105.0",
    "better-auth": "1.7.13",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.19",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
